# Python
.venv/
__pycache__/
*.py[cod]

# Data artifacts — NEVER commit (100+ GB: the ZIM, wiki.db, snapshots, logs, markers).
# Rebuilt from the ZIM via scripts/extract.py; off-site copies live in R2.
/data/

# Quartz site shell — the vendored framework is committed; build artifacts are not.
/site/node_modules/
/site/public/
/site/content/
/site/.quartz-cache/

# Tooling local state
.wrangler/
.claude/settings.local.json

# Terraform (state/providers/secrets; the .lock.hcl IS committed)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# OS
.DS_Store
